# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file — it is ignored by Git.

# Your Anthropic API key (from https://platform.claude.com -> API keys).
# Leave empty to run in Demo mode only.
ANTHROPIC_API_KEY=

# Claude model used for planning. Opus 5.5 is the current default.
ANTHROPIC_MODEL=claude-opus-5-5

# Where your personal SQLite database is stored. Demo data is kept in a
# separate file next to it (nikki-demo.db).
DATABASE_PATH=./data/nikki.db

# Port for the web server.
PORT=3001

# Optional: protects the app with a password. REQUIRED if you ever host it
# publicly. Leave empty for local use on your own computer.
APP_PASSWORD=
