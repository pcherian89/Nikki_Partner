# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file — it is ignored by Git.

# Your Anthropic API key (from https://platform.claude.com -> API keys).
# Leave empty to run in Demo mode only.
ANTHROPIC_API_KEY=

# Claude model used for planning. Opus 5.5 is the current default.
ANTHROPIC_MODEL=claude-opus-5-5

# Where your personal SQLite database is stored. Demo data is kept in a
# separate file next to it (nikki-demo.db).
DATABASE_PATH=./data/nikki.db

# Port for the web server.
PORT=3001

# Optional: protects the app with a password. REQUIRED if you ever host it
# publicly. Leave empty for local use on your own computer.
APP_PASSWORD=

# ---------- Phase 0 security ----------
# Encryption key for secrets at rest (push signing key, two-step sign-in, future account tokens) and for nightly
# backups. 32 random bytes in base64. Create it on your own computer:  openssl rand -base64 32
# Put it ONLY in Railway → Variables (or your local .env). Never in chat, email or the repository.
# If you lose it, encrypted values and backups can't be opened.
NIKKI_ENCRYPTION_KEY=
# During a key change only: the old key, so values sealed with it still open. Remove after "rewrap".
NIKKI_ENCRYPTION_KEY_PREVIOUS=

# Emergency recovery if you lose every two-step sign-in device and recovery code: set to 1 for one deploy,
# sign in, turn two-step sign-in off, then delete this variable.
NIKKI_DISABLE_2FA=

# Optional: the app's public https address (for example https://nikki.up.railway.app). On Railway it is detected
# automatically. Lets iPhone show notifications even if the background worker isn't running (Declarative Web Push).
PUBLIC_URL=

# Phase 1A: Google (read-only Gmail and Calendar). From Google Cloud → your Personal-mode OAuth client.
# Never paste these into chat. The redirect URI in Google Cloud must be PUBLIC_URL + /oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
